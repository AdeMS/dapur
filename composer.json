{
    "name": "adems/dapur",
    "description": "Dapur AdeMS, tempat Ade M Saragih untuk bermain dan belajar membuat website",
    "type": "project",
    "license": "BSD-3-Clause",
    "keywords": [
        "dapur",
        "adems",
        "php",
        "bootstrap",
        "html5"
    ],
    "homepage": "https://www.adems.id",
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": "~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0",
        "twbs/bootstrap": "^5.3",
        "twbs/bootstrap-icons": "^1.13.1"
    },
    "scripts": {
        "post-create-project-cmd": [
            "@setup-bootstrap",
            "@setup-bootstrap-icons"
        ],
        "post-update-cmd": [
            "@setup-bootstrap",
            "@setup-bootstrap-icons"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S 0.0.0.0:8080 -t public/"
        ],
        "setup-bootstrap": [
            "rm -rf public/asset/bootstrap",
            "cp -R vendor/twbs/bootstrap/dist public/asset/bootstrap"
        ],
        "setup-bootstrap-icons": [
            "rm -rf public/asset/bootstrap/font",
            "cp -R vendor/twbs/bootstrap-icons/font public/asset/bootstrap/font"
        ]
    }
}
