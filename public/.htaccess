# Non-aktifkan tanda ciri server pada saat memulai
ServerSignature Off

# Jika modul negosiasi (negotiation) diaktifkan
<IfModule mod_negotiation.c>
    # Nonaktifkan MultiViews dan Indeks
    Options -MultiViews -Indexes
    # Aktifkan FollowSymlinks
    Options +FollowSymlinks
</IfModule>

# Jika modul penulisan ulang (rewrite) diaktifkan
<IfModule mod_rewrite.c>
    # Nyalakan mesin penulisan ulang
    RewriteEngine On

    # Mengalihkan permintaan http ke https
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>