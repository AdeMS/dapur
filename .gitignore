/vendor
composer.lock

# Paket Composer tambahan per instalasi (digabung oleh composer-merge-plugin)
/composer.local.json

# Konfigurasi lokal (berisi password database, dll.)
/config/autoload/local.php
/config/autoload/*.local.php

# Daftar modul tambahan per instalasi
/config/modul.local.php

# Multi-website: daftar website dan folder website terpusat (per instalasi)
/config/multiwebsite.local.php
/config/website/
/data/website/

# Log error (folder dibuat web server dengan izin 2770 saat kesalahan pertama terjadi)
/data/log/

# Mode development (dibuat oleh `composer development-enable`)
/config/development.config.php
