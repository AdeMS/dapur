{
    "name": "adems/dapur",
    "description": "Dapur AdeMS, tempat Ade M Saragih untuk bermain dan belajar membuat website",
    "type": "project",
    "license": "BSD-3-Clause",
    "keywords": [
        "dapur",
        "adems",
        "laminas",
        "php",
        "html5",
        "bootstrap",
        "stylesheet",
        "css"
    ],
    "homepage": "https://www.adems.id",
    "authors": [
        {
            "name": "Ade M Saragih",
            "homepage": "https://www.adems.id"
        }
    ],
    "config": {
        "allow-plugins": {
            "laminas/laminas-component-installer": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "extra": {
        "laminas": {
            "component-ignore-list": [
                "laminas/laminas-db"
            ]
        },
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ],
            "recurse": false,
            "merge-extra": false,
            "merge-scripts": false
        }
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "twbs/bootstrap": "^5.3",
        "twbs/bootstrap-icons": "^1.13.1",
        "laminas/laminas-component-installer": "^3.8",
        "laminas/laminas-diactoros": "^3.9",
        "mezzio/mezzio": "^3.28",
        "laminas/laminas-servicemanager": "^4.5",
        "laminas/laminas-config-aggregator": "^1.20",
        "mezzio/mezzio-fastroute": "^3.14",
        "mezzio/mezzio-laminasviewrenderer": "^3.0",
        "laminas/laminas-cache": "^4.3",
        "laminas/laminas-cache-storage-adapter-filesystem": "^3.2",
        "laminas/laminas-serializer": "^4.0",
        "laminas/laminas-db": "^2.22",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "module/App/src/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@setup-bootstrap",
            "@setup-bootstrap-icons"
        ],
        "post-update-cmd": [
            "@setup-bootstrap",
            "@setup-bootstrap-icons"
        ],
        "clear-config-cache": "php bin/clear-config-cache.php",
        "cek-database": "php bin/cek-database.php",
        "serve": [
          "Composer\\Config::disableProcessTimeout",
          "php -S 0.0.0.0:8080 -t public/"
        ],
        "setup-bootstrap": [
            "rm -rf public/asset/bootstrap",
            "cp -R vendor/twbs/bootstrap/dist public/asset/bootstrap"
        ],
        "setup-bootstrap-icons": [
            "rm -rf public/asset/bootstrap/font",
            "cp -R vendor/twbs/bootstrap-icons/font public/asset/bootstrap/font"
        ]
    }
}
